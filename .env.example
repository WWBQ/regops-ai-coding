# Copy to .env. Never commit real keys.
REGOPS_SERVICE_TOKEN=
AGENT_DATABASE_URL=postgresql://user:password@localhost:5432/ai_coding
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_IDS=deepseek-flash,deepseek-v4-pro
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_IDS=qwen3.8-max,qwen3.8-flash,qwen3.7-plus
MAIN_MODEL=deepseek-v4-pro
AI_CODING_EXECUTION_BACKEND=opensandbox
AI_CODING_SANDBOX_DOMAIN=127.0.0.1:8090
AI_CODING_SANDBOX_API_KEY=
AI_CODING_SANDBOX_PROTOCOL=http
AI_CODING_SANDBOX_IMAGE=opensandbox/code-interpreter:v1.1.0
# local is self-contained development storage; mount AI_CODING_OBJECT_DIR persistently.
AI_CODING_SNAPSHOT_BACKEND=local
AI_CODING_OBJECT_DIR=./data/objects
# Set backend=regops to use the existing RegOps private object-store endpoint.
REGOPS_API_BASE_URL=http://127.0.0.1:8000
AGENT_CODING_MAX_TOOL_CALLS=300
AGENT_CODING_MAX_SECONDS=1800
